# CollabNGrow Passion Analyzer — environment template
#
# Copy to .env.local and fill in. Never commit a filled-in copy: .gitignore
# excludes every .env* file except this template.
#
# master_prompt.md §51, §83.

# -----------------------------------------------------------------------------
# Firebase web configuration (public)
# -----------------------------------------------------------------------------
# These ship in the client bundle and are not secrets. Firebase Console ->
# Project Settings -> General -> Your apps -> SDK setup and configuration.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# -----------------------------------------------------------------------------
# Firebase Admin service account (SECRET — server only)
# -----------------------------------------------------------------------------
# Firebase Console -> Project Settings -> Service Accounts -> Generate new
# private key. Take client_email and private_key from the downloaded JSON.
# Keep the quotes and the literal \n escapes in the private key.
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=""

# -----------------------------------------------------------------------------
# Cryptography (SECRET — server only)
# -----------------------------------------------------------------------------
# Generate each with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
#
# INVITATION_PASSWORD_ENCRYPTION_KEY encrypts recoverable invitation passwords
# for administrator reveal (§10). Losing it makes existing passwords
# unrecoverable; rotating it requires rotating every invitation password.
INVITATION_PASSWORD_ENCRYPTION_KEY=

# INVITE_GRANT_SECRET signs the HttpOnly cookie proving a visitor passed
# invitation password verification. Rotating it signs everyone out of the
# password step; invitation bindings are unaffected.
INVITE_GRANT_SECRET=

# -----------------------------------------------------------------------------
# Administration
# -----------------------------------------------------------------------------
# The single authorised administrator, enforced server-side (§21).
ADMIN_EMAIL=collabwinwin@gmail.com

# -----------------------------------------------------------------------------
# Gemini (SECRET — server only)
# -----------------------------------------------------------------------------
# https://aistudio.google.com/apikey
# At least key 1 is required. Keys 2 and 3 extend quota fallback (§33, §35).
GEMINI_API_KEY_1=
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=

# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------
# Absolute base URL, used to build shareable invitation links (§29).
NEXT_PUBLIC_APP_URL=http://localhost:3000
